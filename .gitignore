# ── Dependencies ────────────────────────────────────────────
node_modules/
.pnp/
.pnp.js
jspm_packages/

# ── Environment and secrets ─────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ── Build output ────────────────────────────────────────────
# This site has no build step: index.html, styles.css and main.js are the
# deployable artefacts and must stay tracked. These cover the usual framework
# output folders in case the project ever grows one.
dist/
build/
out/
.next/
.nuxt/
.svelte-kit/
.astro/
.cache/
.parcel-cache/
.vercel/
.netlify/

# ── Tooling noise ───────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
*.log
npm-debug.log*
yarn-error.log*

# ── Editor and OS ───────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp
*.swo
.vscode/*
!.vscode/settings.json

# ── Local scratch ───────────────────────────────────────────
# Probe pages written during layout testing, never part of the site.
_*.html
_*.js

# ── Build inputs, never deployed ────────────────────────────
# Master artwork the scripts/ pipeline reads from. Kept out of assets/ so it is
# not published: logo.png alone is 83 KB that no page ever requests.
masters/

# ── Raw video originals — never commit these ────────────────
# Camera/export masters for the /videos/ web encodes, ~385 MB. Kept locally as
# the backup to re-encode from; the compressed MP4s in videos/ are what ship.
videos-raw/
